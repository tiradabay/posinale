Options -Indexes -ExecCGI
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py .shtml
RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py .shtml
RewriteEngine On
RewriteRule !\.(?:png|jpe?g|gif|webp)$ - [F,END,NC]
<FilesMatch "(?i)\.(?:php[0-9]*|phtml|phar|cgi|pl|py|asp|aspx|shtml|htaccess)(?:\.|$)">
    Require all denied
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"
Header always set Content-Security-Policy "default-src 'none'; sandbox"